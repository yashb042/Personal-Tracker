# Local server.js only (optional — not needed for production).
# For cloud Telegram + reminders, set these as GitHub repo Secrets instead.
# See GITHUB_SETUP.md

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Enable only for a standalone local bot with no GitHub Actions reminders.
TRACKER_LOCAL_REMINDERS=false
